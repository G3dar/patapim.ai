/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Remote pages are prerendered static assets (no SSR/middleware) — always
# revalidate so a deploy shows up on the next open (cheap ETag 304s).
# /remotedesk embeds the device's /desktop in an iframe with allow="microphone
# …" — the global Permissions-Policy above denies microphone, which would
# break voice dictation delegation once these are asset-served, so re-allow it.
# NOTE: the assets binding serves these at the trailing-slash URL (/remote →
# 307 → /remote/), and _headers paths match exactly — both forms listed.
/remote
  Cache-Control: no-cache
/remote/
  Cache-Control: no-cache
/remotedesk
  Cache-Control: no-cache
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=*, geolocation=()
/remotedesk/
  Cache-Control: no-cache
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=*, geolocation=()
/remote-mobile
  Cache-Control: no-cache
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
/remote-mobile/
  Cache-Control: no-cache
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# Remote UIs ship their JS inline in the HTML document, so the HTML response IS
# the cache surface. Force revalidation so deploys reach phones without a manual
# hard-reload / cache-bust query.
/remote
  Cache-Control: no-cache
/remotedesk
  Cache-Control: no-cache
